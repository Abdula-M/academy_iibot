academy-skfo.online {
    # API endpoints
    handle /api/* {
        reverse_proxy bot:8000
    }
    
    # Webhook endpoint
    handle /webhook* {
        reverse_proxy bot:8000
    }
    
    # Swagger docs
    handle /docs* {
        reverse_proxy bot:8000
    }
    handle /openapi.json {
        reverse_proxy bot:8000
    }
    
    # Frontend (React SPA dashboard)
    handle {
        reverse_proxy frontend:80
    }
}
