# Тестовый режим без внешнего API. Ответы берутся напрямую из knowledge.txt.
VOICE_LLM_PROVIDER=local

# Для проверки ответов через DeepSeek замените local на deepseek и задайте ключ.
# VOICE_LLM_PROVIDER=deepseek
VOICE_DEEPSEEK_API_KEY=
VOICE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VOICE_DEEPSEEK_MODEL=deepseek-v4-flash

# Отдельная Redis DB, чтобы не смешивать телефонные сессии с мессенджерами.
VOICE_SESSION_BACKEND=redis
VOICE_REDIS_URL=redis://redis:6379/1

# Речь. mock не вызывает внешние API и подходит для безопасного теста шлюза.
VOICE_SPEECH_PROVIDER=mock
# Для реального распознавания и озвучивания замените mock на yandex.
VOICE_YANDEX_API_KEY=
VOICE_YANDEX_FOLDER_ID=
VOICE_YANDEX_STT_LANGUAGE=ru-RU
VOICE_YANDEX_STT_MODEL=general
VOICE_YANDEX_STT_EOU_SENSITIVITY=high
VOICE_YANDEX_STT_MAX_PAUSE_MS=500
VOICE_YANDEX_TTS_VOICE=marina
VOICE_YANDEX_TTS_ROLE=friendly
VOICE_YANDEX_TTS_SPEED=1.03

# Телефонный WebSocket закрыт по умолчанию. Включайте только с длинным секретом.
VOICE_TELEPHONY_ENABLED=false
VOICE_TELEPHONY_USERNAME=voice
VOICE_TELEPHONY_TOKEN=
VOICE_TELEPHONY_TEST_MODE=false
VOICE_THINKING_PROMPT_DELAY_SECONDS=0.45

# Защищенная страница для проверки голоса без настоящего телефонного номера.
VOICE_BROWSER_TEST_ENABLED=false
VOICE_BROWSER_TEST_TOKEN=

# SIP-номер/внутренний номер сотрудника задается в сценарии Asterisk.
VOICE_OPERATOR_NUMBER=
VOICE_PORT=8100
