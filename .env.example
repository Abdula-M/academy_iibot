# ============================================================
#  AI Telegram Bot — переменные окружения
#
#  Скопируйте этот файл:  cp .env.example .env
#  Заполните значения и запустите:  docker compose up -d --build
# ============================================================

# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token

# ── Режим работы (polling / webhook) ─────────────────────
# polling — для локального тестирования (не нужен домен)
# webhook — для продакшена (нужен публичный HTTPS-адрес)
USE_WEBHOOK=false

# ── Webhook (только если USE_WEBHOOK=true) ───────────────
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=ai_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_strong_password

# Для Docker: хост = postgres (имя сервиса)
# Для локальной разработки: хост = localhost
DATABASE_URL=postgresql+asyncpg://postgres:change_me_to_strong_password@postgres:5432/ai_bot

# ── Redis ────────────────────────────────────────────────
# Для Docker: redis://redis:6379/0
# Для локальной разработки: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ── RAG / ChromaDB ───────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=knowledge_base
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── DeepSeek LLM ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Общие ─────────────────────────────────────────────────
DEBUG=false
